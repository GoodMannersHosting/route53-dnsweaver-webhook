# Settings for route53-dnsweaver-webhook.service. Values are plain
# KEY=value pairs; systemd does no shell expansion here, so leave them
# unquoted.

# Required. The service refuses to start without it.
ROUTE53_HOSTED_ZONE_ID=

# The shared secret dnsweaver has to present. Set both or neither: with
# neither, anyone who can reach the port can change DNS records.
WEBHOOK_AUTH_HEADER=X-Webhook-Token
WEBHOOK_AUTH_TOKEN=

#PORT=8080
#ROUTE53_DEFAULT_TTL=300
#LOG_LEVEL=info

# Credentials for the AWS SDK. An instance profile or IAM Roles Anywhere
# needs nothing here; otherwise set a region and a credential source.
#AWS_REGION=us-east-1
